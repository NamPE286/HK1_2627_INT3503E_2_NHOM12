# Copy thành .env (KHÔNG commit .env)
NODE_ENV=development
PORT=8000
DATABASE_URL=postgresql://trafficlex:trafficlex@localhost:5432/trafficlex
# Base URL công khai của API (Better Auth dùng để tạo callback/cookie)
BETTER_AUTH_URL=http://localhost:8000
# >= 32 ký tự ngẫu nhiên: openssl rand -base64 32
BETTER_AUTH_SECRET=change-me-change-me-change-me-change-me
CORS_ORIGINS=http://localhost:5173
LOG_LEVEL=info
UPLOAD_DIR=./storage
UPLOAD_MAX_BYTES=20971520
