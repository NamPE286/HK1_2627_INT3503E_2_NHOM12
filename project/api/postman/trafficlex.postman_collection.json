{
  "info": {
    "name": "TrafficLex API v1",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Luồng 1.0.0: đăng ký/đăng nhập (Better Auth) → tạo văn bản → upload file → list. Chạy: bun run test:newman Request tới /api/auth/* gửi header Origin (Better Auth chống CSRF)."
  },
  "item": [
    {
      "name": "Sign up (Better Auth)",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "pm.environment.set('run_email', `demo+${Date.now()}@example.com`);"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('200', () => pm.response.to.have.status(200));",
              "pm.environment.set('token', pm.response.headers.get('set-auth-token'));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Origin",
            "value": "http://localhost:5173"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/auth/sign-up/email",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "auth",
            "sign-up",
            "email"
          ]
        },
        "auth": {
          "type": "noauth"
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{run_email}}\",\n  \"password\": \"{{password}}\",\n  \"name\": \"Demo\"\n}"
        }
      }
    },
    {
      "name": "Sign in (Better Auth)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('200 + token', () => { pm.response.to.have.status(200); pm.expect(pm.response.headers.get('set-auth-token')).to.be.a('string'); });",
              "pm.environment.set('token', pm.response.headers.get('set-auth-token'));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Origin",
            "value": "http://localhost:5173"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/auth/sign-in/email",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "auth",
            "sign-in",
            "email"
          ]
        },
        "auth": {
          "type": "noauth"
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{run_email}}\",\n  \"password\": \"{{password}}\"\n}"
        }
      }
    },
    {
      "name": "Sign in sai mật khẩu → 401",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('401', () => pm.response.to.have.status(401));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Origin",
            "value": "http://localhost:5173"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/auth/sign-in/email",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "auth",
            "sign-in",
            "email"
          ]
        },
        "auth": {
          "type": "noauth"
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{run_email}}\",\n  \"password\": \"wrong-password\"\n}"
        }
      }
    },
    {
      "name": "Me",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('200', () => pm.response.to.have.status(200));",
              "pm.test('no password', () => pm.expect(pm.response.json()).to.not.have.property('password'));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/api/v1/users/me",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "v1",
            "users",
            "me"
          ]
        },
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{token}}",
              "type": "string"
            }
          ]
        }
      }
    },
    {
      "name": "Me với token rác → 401 problem+json",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('401', () => pm.response.to.have.status(401));",
              "pm.test('problem+json', () => pm.expect(pm.response.headers.get('Content-Type')).to.include('application/problem+json'));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/api/v1/users/me",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "v1",
            "users",
            "me"
          ]
        },
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "garbage-token",
              "type": "string"
            }
          ]
        }
      }
    },
    {
      "name": "Create legal document",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('201 + Location', () => { pm.response.to.have.status(201); pm.expect(pm.response.headers.get('Location')).to.include('/api/v1/legal-documents/'); });",
              "pm.environment.set('document_id', pm.response.json().id);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/v1/legal-documents",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "v1",
            "legal-documents"
          ]
        },
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{token}}",
              "type": "string"
            }
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"doc_type\": \"NGHI_DINH\",\n  \"number\": \"168/2024/NĐ-CP\",\n  \"title\": \"Quy định xử phạt vi phạm hành chính về trật tự, an toàn giao thông trong lĩnh vực giao thông đường bộ\",\n  \"issuer\": \"Chính phủ\",\n  \"issued_date\": \"2024-12-26\",\n  \"effective_date\": \"2025-01-01\"\n}"
        }
      }
    },
    {
      "name": "Create duplicate → 409",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('409', () => pm.response.to.have.status(409));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/v1/legal-documents",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "v1",
            "legal-documents"
          ]
        },
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{token}}",
              "type": "string"
            }
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"doc_type\": \"NGHI_DINH\",\n  \"number\": \"168/2024/NĐ-CP\",\n  \"title\": \"dup\",\n  \"issuer\": \"Chính phủ\"\n}"
        }
      }
    },
    {
      "name": "Create invalid → 422",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('422', () => pm.response.to.have.status(422));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/v1/legal-documents",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "v1",
            "legal-documents"
          ]
        },
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{token}}",
              "type": "string"
            }
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"doc_type\": \"BOGUS\",\n  \"number\": \"\",\n  \"title\": \"x\",\n  \"issuer\": \"y\"\n}"
        }
      }
    },
    {
      "name": "Upload source file (chọn file PDF/DOCX/TXT)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('201', () => pm.response.to.have.status(201));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [],
        "url": {
          "raw": "{{base_url}}/api/v1/legal-documents/{{document_id}}/source-files",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "v1",
            "legal-documents",
            "{{document_id}}",
            "source-files"
          ]
        },
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{token}}",
              "type": "string"
            }
          ]
        },
        "body": {
          "mode": "formdata",
          "formdata": [
            {
              "key": "file",
              "type": "file",
              "src": "sample.txt"
            }
          ]
        }
      }
    },
    {
      "name": "List legal documents",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('200 + pagination', () => { pm.response.to.have.status(200); pm.expect(pm.response.json().pagination.total_items).to.be.at.least(1); });"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/api/v1/legal-documents?page=1&page_size=20&sort=-issued_date",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "v1",
            "legal-documents"
          ],
          "query": [
            {
              "key": "page",
              "value": "1"
            },
            {
              "key": "page_size",
              "value": "20"
            },
            {
              "key": "sort",
              "value": "-issued_date"
            }
          ]
        },
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{token}}",
              "type": "string"
            }
          ]
        }
      }
    },
    {
      "name": "List with bad page_size → 400",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('400', () => pm.response.to.have.status(400));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/api/v1/legal-documents?page_size=1000",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "v1",
            "legal-documents"
          ],
          "query": [
            {
              "key": "page_size",
              "value": "1000"
            }
          ]
        },
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{token}}",
              "type": "string"
            }
          ]
        }
      }
    },
    {
      "name": "List source files",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('200', () => pm.response.to.have.status(200));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/api/v1/legal-documents/{{document_id}}/source-files",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "v1",
            "legal-documents",
            "{{document_id}}",
            "source-files"
          ]
        },
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{token}}",
              "type": "string"
            }
          ]
        }
      }
    },
    {
      "name": "Publish",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('200', () => pm.response.to.have.status(200));",
              "pm.test('PUBLISHED', () => pm.expect(pm.response.json().status).to.eql('PUBLISHED'));"
            ]
          }
        }
      ],
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/v1/legal-documents/{{document_id}}",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "v1",
            "legal-documents",
            "{{document_id}}"
          ]
        },
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{token}}",
              "type": "string"
            }
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"status\": \"PUBLISHED\"\n}"
        }
      }
    },
    {
      "name": "Publish → DRAFT không hợp lệ → 409",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('409', () => pm.response.to.have.status(409));"
            ]
          }
        }
      ],
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/v1/legal-documents/{{document_id}}",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "v1",
            "legal-documents",
            "{{document_id}}"
          ]
        },
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{token}}",
              "type": "string"
            }
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"status\": \"DRAFT\"\n}"
        }
      }
    },
    {
      "name": "Sign out",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('200', () => pm.response.to.have.status(200));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Origin",
            "value": "http://localhost:5173"
