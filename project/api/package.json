{
  "name": "trafficlex-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "start": "bun src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "test:coverage": "bun test --coverage",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "bun src/db/migrate.ts",
    "db:seed": "bun src/db/seed.ts",
    "lint:spec": "spectral lint ../docs/api/openapi.yaml --ruleset ../.spectral.yaml",
    "test:newman": "newman run postman/trafficlex.postman_collection.json -e postman/local.postman_environment.json --working-dir postman"
  },
  "dependencies": {
    "@elysiajs/cors": "1.4.3",
    "better-auth": "1.7.28",
    "drizzle-orm": "0.45.4",
    "elysia": "1.4.32",
    "pg": "8.23.1",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.6.0",
    "@stoplight/spectral-cli": "6",
    "@types/bun": "^1.4.5",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "0.31.11",
    "newman": "^6.2.3",
    "typescript": "5.9.3"
  }
}
